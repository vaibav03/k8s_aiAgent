# Copy to .env (git-ignored) and adjust. All values are optional; defaults shown.

# Prometheus HTTP API (e.g. kubectl -n monitoring port-forward svc/prometheus-operated 9090)
PROMETHEUS_URL=http://localhost:9090
# Kubernetes API. Locally: `kubectl proxy --port=8001`. In cluster: https://kubernetes.default.svc
# (bearer token is read automatically from the service-account token file when present).
KUBE_API=http://localhost:8001
NAMESPACE=default
# Label selector for pods to watch; empty = every pod in NAMESPACE
POD_SELECTOR=app=finalpod
# ML service (ml_service/, FastAPI)
ML_URL=http://localhost:8000
# Items per POST /v1/predict/batch (one item per container; the service caps a batch at 500)
ML_BATCH_MAX=500

# Loop. Keep POLL_MS >= the Prometheus scrape interval (15-30 s), otherwise most
# samples are stale duplicates (94% of the old 1 s training rows were).
POLL_MS=15000
# Samples kept per pod and sent to the model (40 x 15 s = 10 min)
WINDOW=40
# Alert when >= ALERT_K of the last ALERT_N predictions are anomalous
ALERT_K=2
ALERT_N=3
# Minimum time between alerts / LLM calls per pod
COOLDOWN_MS=300000

# LLM (optional). Without a key the LLM step is skipped and the recommendation is recorded as "none".
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=

# Remediation safety. false => kubectl runs with --dry-run=server only.
ALLOW_EXEC=false
KUBECTL=kubectl
MAX_MEMORY_LIMIT=4Gi
MAX_REPLICAS=10

PORT=3001

# Per-pod OOM loop on/off. Empty = on only when the deployment loop is off. Obeys ACT_MODE
# (observe: no kubectl), cannot scale, shares the per-Deployment remediation cooldown.
OOM_LOOP=

# Deployment-level decision loop (POST /v1/decide). Off while both are empty.
DEPLOYMENTS=
DEPLOY_SELECTOR=
# observe (log only) | dryrun (kubectl --dry-run=server) | act (real; needs ALLOW_EXEC=true)
ACT_MODE=observe
DECIDE_INTERVAL_S=15
HISTORY_S=900
SCALE_MIN=1
SCALE_MAX=10
SCALE_UP_COOLDOWN_S=15
SCALE_DOWN_COOLDOWN_S=60
REMEDIATION_COOLDOWN_S=300
# never fight an HPA unless this is true
HPA_OVERRIDE=false
# also append every decision (one JSON line) to this file
DECISION_LOG=
APP_CONTAINER=app
APP_JOB=annotated-pods
# per-Deployment template, e.g. app="{deployment}"; empty = namespace-wide (refused when the
# namespace has several Deployments)
APP_METRIC_MATCHER=
